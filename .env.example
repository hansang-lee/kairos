# ============================================================
# kairos 환경변수 템플릿
# 이 파일을 .env로 복사하고 실제 값을 입력하세요:
#   cp .env.example .env
# ============================================================

# ── 한국투자증권 OpenAPI ──
# KIS Developers (https://apiportal.koreainvestment.com) 에서 발급

# 투자 모드: paper (모의투자) / live (실전투자)
KIS_MODE=paper

# --- 모의투자용 ---
# 모의투자 전용 AppKey를 별도로 발급받아야 합니다
# [앱등록] > 용도: 모의투자
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=        # 모의투자 계좌번호 (8자리)
KIS_PAPER_ACCOUNT_PROD=01

# --- 실전투자용 ---
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=         # 종합계좌번호 앞 8자리
KIS_REAL_ACCOUNT_PROD=01

# ── FRED API ──
# https://fred.stlouisfed.org/docs/api/api_key.html 에서 발급
FRED_API_KEY=

# ── Telegram Bot (Phase 3) ──
# @BotFather 에서 봇 생성 후 토큰 입력
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 대시보드 서버 (Phase 3) ──
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0
