[Unit]
Description=kairos trader (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__ROOT__
# Dry-run by default: this places no orders. Append --live once a real order has
# been confirmed end to end, since the timer then trades unattended.
#
# --once runs a single cycle and exits, which is the right shape while only
# once-a-day profiles are enabled: there is no reason to keep a process asleep
# for 23 hours, and systemd handles clock changes and resume better than a loop
# would. It still honours market hours and holidays, so a firing on a closed day
# does nothing.
#
# To run minute-bar ('scalp') profiles, this must become a continuous loop
# instead — change Type to simple, drop --once, and add Restart=on-failure. The
# binary supports both; only the unit changes.
ExecStart=__ROOT__/build/Release/app/trader --once --daily-at 1515
