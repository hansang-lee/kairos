[Unit]
Description=kairos daily strategy run (one shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__ROOT__
# Dry-run by default: this places no orders. Append --live once a real order has
# been confirmed end to end, since the timer will then trade unattended.
ExecStart=__ROOT__/build/Release/app/daily_trade --all
